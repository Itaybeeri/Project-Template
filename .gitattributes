# The release-note HTML is generated by ReleaseNotes/generate.mjs, which always writes
# LF. Without this, a Windows checkout (core.autocrlf=true) converts it to CRLF, so the
# very next `node ReleaseNotes/generate.mjs` — a mandatory phase-5 step — reports five
# modified files that contain no actual changes. Pin the generated output to LF so the
# generator is a genuine no-op when nothing changed.
ReleaseNotes/*.html text eol=lf

# Same reasoning for the command center's generated snapshot (git-ignored, but explicit).
ProjectCommandCenter/snapshot.html text eol=lf
